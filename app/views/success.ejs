<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Sent - BookExchange</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="center-content" style="display: flex; justify-content: center; align-items: center; min-height: 60vh; text-align: center;">
        <div class="clean-form-card" style="max-width: 500px; padding: 3rem;">
            <h1 style="font-size: 4rem; color: var(--ur-green); margin-bottom: 1rem;">✓</h1>
            <h2 style="color: var(--ur-green); margin-bottom: 1rem;">Message Sent Successfully!</h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">
                Your email has been securely forwarded. Keep an eye on your inbox for a reply!
            </p>
            <a href="/" style="text-decoration: none;">
                <button class="publish-btn" style="width: 100%;">Back to Home</button>
            </a>
        </div>
    </main>
</body>
</html>