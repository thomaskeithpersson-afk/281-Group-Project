    <main class="post-page-layout">
        <div class="clean-form-card">
            <h2>Book Details</h2>
            <form action="/post" method="POST" enctype="multipart/form-data">   
                <label>Book Picture</label>
                <div class="image-upload-wrapper">
                    <input type="file" name="image" id="bookImageInput" accept="image/*" required>
                    <div id="imagePreview" class="image-preview">
                        <span>Preview will appear here</span>
                    </div>
                </div>
                <label>Book Title</label>
                <input type="text" name="title" placeholder="(e.g. 'Introduction to Software Engineering')" required>
                <label>Department</label>
                <input type="text" name="department" placeholder="ENSE" required>
                <label>Course Number</label>
                <input type="text" name="courseNumber" placeholder="101" required>
                <label>Condition</label>
                <select name="condition">
                    <option value="New">New</option>
                    <option value="Like New">Like New</option>
                    <option value="Used">Used</option>
                    <option value="Bad">Bad</option>
                </select>
                <label>Price</label>
                <input type="number" name="price" placeholder="$100" required>
                <label>Your Name/Handle *</label>
                <input type="text" name="sellerName" placeholder="(e.g. 'Chop P')" required>
                <label>Contact Detail</label>
                <input type="text" name="contact" placeholder="Email or phone" required>
                <label>Optional Descriptions/Notes</label>
                <textarea name="notes" rows="3"></textarea>
                <button type="submit" class="publish-btn">Publish Listing</button>
                <a href="/" class="cancel-btn">Cancel</a>
            </form>
        </div>
    </main>
    <script src="/script.js"></script>
